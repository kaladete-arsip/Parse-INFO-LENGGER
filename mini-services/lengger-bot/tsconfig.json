{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@budaya/*": ["../../src/lib/budaya/*"]
    },
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "../../src/lib/budaya/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
