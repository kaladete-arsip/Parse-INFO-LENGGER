# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Worker (Cloudflare Worker)
worker/.dev.vars
worker/.wrangler/
worker/dist/
upload/

# Binary/generated files (don't commit — regenerate locally)
public/source.zip
public/PLAN.md
worker/package-lock.json
*.xlsx

# Photos: ignore everywhere EXCEPT lengger-bot storage (real TikTok photos = data, must be on GitHub)
*.jpg
*.jpeg
*.png
*.webp
!mini-services/lengger-bot/storage/**/*.jpg
!mini-services/lengger-bot/storage/**/*.jpeg
!mini-services/lengger-bot/storage/**/*.png
!mini-services/lengger-bot/storage/**/*.webp

# Lengger bot temp/generated (NOT the storage data — that's committed)
mini-services/lengger-bot/sample-flyers/
mini-services/lengger-bot/flyer-templates/
